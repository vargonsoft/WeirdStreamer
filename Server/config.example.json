{
  "server": {
    "port": 8080,
    "host": "0.0.0.0"
  },
  "database": {
    "path": "./data/media.db"
  },
  "media": {
    "paths": [
      "/path/to/media/folder1",
      "/path/to/media/folder2"
    ],
    "thumbnailPath": "./thumbnails",
    "supportedVideoFormats": [".mp4", ".mkv", ".avi", ".mov", ".wmv", ".flv", ".webm", ".3gp", ".3gpp", ".m4v", ".mpg", ".mpeg"],
    "supportedImageFormats": [".jpg", ".jpeg", ".png", ".gif", ".bmp", ".webp"],
    "supportedDocFormats": [".pdf"]
  },
  "auth": {
    "jwtSecret": "change-this-to-a-random-secret-key",
    "tokenExpiryHours": 720
  },
  "streaming": {
    "chunkSize": 1048576,
    "enableHTTP2": true
  }
}
