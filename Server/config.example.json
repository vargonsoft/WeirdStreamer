{
  "server": {
    "port": 8080,
    "host": "0.0.0.0"
  },
  "database": {
    "userPath": "./data/users.db",
    "mediaPath": "./data/media.db"
  },
  "media": {
    "paths": [
      {
        "name": "Movies",
        "path": "/path/to/media/movies",
        "groups": ["adults", "admins"]
      },
      {
        "name": "TV Shows",
        "path": "/path/to/media/tv",
        "groups": ["kids", "adults", "admins"]
      },
      {
        "name": "Photos",
        "path": "/path/to/media/photos",
        "groups": ["adults", "admins"]
      }
    ],
    "thumbnailPath": "./thumbnails",
    "trickplayPath": "./trickplay",
    "supportedVideoFormats": [".mp4", ".mkv", ".avi", ".mov", ".wmv", ".flv", ".webm", ".3gp", ".3gpp", ".m4v", ".mpg", ".mpeg", ".ts", ".mp2"],
    "supportedImageFormats": [".jpg", ".jpeg", ".png", ".gif", ".bmp", ".webp"],
    "supportedDocFormats": [".pdf"]
  },
  "auth": {
    "jwtSecret": "change-this-to-a-random-secret-key",
    "tokenExpiryHours": 720
  },
  "streaming": {
    "chunkSize": 1048576,
    "enableHTTP2": true,
    "autoConvertImages": true
  }
}
