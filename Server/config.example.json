{
  "groups": ["parents", "admins", "kids"],
  "server": {
    "port": 8080,
    "host": "0.0.0.0",
    "certFile": "cert.pem",
    "keyFile": "key.pem",
    "logsPath": "./var/logs"
  },
  "database": {
    "userPath": "./var/data/users.db",
    "mediaPath": "./var/data/media.db"
  },
  "media": {
    "paths": [
      {
        "name": "Movies",
        "path": "/path/to/media/movies",
        "groups": ["parents", "admins"],
        "type": "movie"
      },
      {
        "name": "TV Shows",
        "path": "/path/to/media/tv",
        "groups": ["kids", "parents", "admins"],
        "type": "tv"
      },
      {
        "name": "Photos",
        "path": "/path/to/media/photos",
        "groups": ["parents", "admins"]
      }
    ],
    "thumbnailPath": "./var/thumbnails",
    "trickplayPath": "./var/trickplay",
    "artworkPath": "./var/artwork",
    "downloadPath": "./var/downloads",
    "supportedVideoFormats": [".mp4", ".mkv", ".avi", ".divx", ".xvid", ".iso", ".mov", ".wmv", ".flv", ".webm", ".3gp", ".3gpp", ".m4v", ".mpg", ".mpeg", ".ts", ".mp2"],
    "supportedImageFormats": [".jpg", ".jpeg", ".png", ".gif", ".bmp", ".webp"],
    "supportedDocFormats": [".pdf"],
    "ignoreMacFiles": false
  },
  "auth": {
    "jwtSecret": "change-this-to-a-random-secret-key",
    "tokenExpiryHours": 720
  },
  "streaming": {
    "chunkSize": 1048576,
    "enableHTTP2": true,
    "autoConvertImages": true
  },
  "metadata": {
    "tmdbAccessToken": "",
    "language": "en-US"
  }
}
