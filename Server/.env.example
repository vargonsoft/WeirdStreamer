# Media Streaming Server Environment Variables
# Copy this file to .env and update the values

# Server Configuration
SERVER_PORT=8080
SERVER_HOST=0.0.0.0

# Database
DATABASE_PATH=./data/media.db

# Authentication
JWT_SECRET=change-this-to-a-very-secure-random-secret-key
TOKEN_EXPIRY_HOURS=720

# Media Paths (comma-separated)
MEDIA_PATHS=/path/to/videos,/path/to/photos

# Thumbnails
THUMBNAIL_PATH=./thumbnails

# Streaming
CHUNK_SIZE=1048576
ENABLE_HTTP2=false

# Config file (alternative to env vars)
CONFIG_PATH=./config.json

# For HTTPS/HTTP2
# CERT_FILE=cert.pem
# KEY_FILE=key.pem
